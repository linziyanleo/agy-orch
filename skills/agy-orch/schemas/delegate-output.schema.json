{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgyOrchDelegateOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "modified_files", "tests_run", "open_issues"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "summary": {
      "type": "string"
    },
    "modified_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests_run": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_issues": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
